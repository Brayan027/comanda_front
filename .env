# Configuración de API
# Para desarrollo: http://localhost:400/api
# Para producción: La URL DEL servidor 
VITE_API_BASE_URL=/comandaApi

# CONFIGURACIÓN DEL SONIDO DE NOTIFICACIÓN DE PEDIDOS PENDIENTES
# Puedes colocar un número (1, 2, 3) o directamente el NOMBRE DEL ARCHIVO de audio de la carpeta /sonido/
# Ejemplos:
# VITE_TIPO_SONIDO_PENDIENTES=1              -> Beep doble clásico
# VITE_TIPO_SONIDO_PENDIENTES=2              -> Timbre de cocina POS (Campanilla)
# VITE_TIPO_SONIDO_PENDIENTES=3              -> Alerta urgente (Sirena)
# VITE_TIPO_SONIDO_PENDIENTES=SONIDO2.mp3    -> Busca y reproduce el archivo /sonido/SONIDO2.mp3
VITE_TIPO_SONIDO_PENDIENTES=1
